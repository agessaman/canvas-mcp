# Canvas API Configuration
# Replace with your Canvas API token
CANVAS_API_TOKEN=your_canvas_api_token_here
# Replace with your Canvas instance URL
CANVAS_BASE_URL=https://your-canvas-instance.instructure.com

# Optional. Set to true to add the New Quizzes item bank and stimulus tools.
# They reach an undocumented Instructure service rather than the Canvas API and
# can break without notice, so they are off unless you ask for them.
CANVAS_ENABLE_ITEM_BANKS=false
